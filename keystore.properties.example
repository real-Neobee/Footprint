# ============================================================
# keystore.properties 模板（发布签名配置）
# 用法：当你拿到自己的 .jks 签名文件后，复制本文件并改名为
#       keystore.properties（去掉 .example），把下面 4 行填好，
#       与 .jks 文件一起放在【项目根目录】即可。
#
# 安全警告：
#   1) keystore.properties 和 .jks 文件 = 你应用的“身份证+钥匙”。
#   2) 绝对不要提交到【公开】仓库，也不要发给别人。
#   3) 弄丢了 = 以后永远无法给已安装用户升级版本（只能换包名重新上架）。
#
# storeFile 写相对于项目根目录的文件名，例如 release-keystore.jks
storeFile=release-keystore.jks
storePassword=你的密钥库密码
keyAlias=footprint
keyPassword=你的Key密码（可与密钥库密码相同）
